# Postgres / Neon connection string used by db/database.py.
# Copy this file to .env and fill in your own Neon credentials.
#
# Get this from the Neon console → your project → "Connection Details".
# Keep sslmode=require for Neon. The optional -pooler host uses Neon's
# connection pooler, which is recommended for serverless/many-connection apps.
DATABASE_URL=postgresql://user:password@ep-xxxx-xxxx.region.aws.neon.tech/dbname?sslmode=require

# ── Authentication (core/config.py) ──────────────────────────────────────────
# Secret used to sign JWTs. MUST be a long, random, secret value in production
# (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`). If unset
# the app falls back to an insecure development default and logs a warning.
JWT_SECRET_KEY=change-me-to-a-long-random-secret
# Optional overrides (defaults shown):
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ── Auth cookies (core/config.py) ─────────────────────────────────────────────
# The access & refresh tokens are delivered as HTTP-only cookies (never in the
# response body). Defaults shown; the defaults work for local http://localhost
# dev because localhost is same-site and browsers accept Secure cookies there.
# COOKIE_SECURE=true          # only send cookies over HTTPS
# COOKIE_SAMESITE=lax         # lax | strict | none  (none requires COOKIE_SECURE=true)
# COOKIE_DOMAIN=              # e.g. .example.com to share cookies across subdomains

# ── CORS (main.py) ────────────────────────────────────────────────────────────
# Credentialed (cookie) requests cannot use a wildcard origin, so list the exact
# frontend origin(s). Defaults to http://localhost:3000 (local dev) and
# https://panchangam.santhigiri.app (production frontend). Override to replace
# the list entirely if you need a different set of origins.
# CORS_ALLOW_ORIGINS=["https://app.example.com"]
#
# CORS_ALLOW_ORIGIN_REGEX currently defaults to `https://.*`, temporarily
# allowing ANY HTTPS origin (matched via regex so credentialed requests still
# work correctly — the specific Origin is reflected back, not a literal "*").
# To tighten this back down, narrow the regex to a specific domain pattern, or
# set it to an empty value to disable it and rely on CORS_ALLOW_ORIGINS alone.
# CORS_ALLOW_ORIGIN_REGEX=https://.*\.santhigiri\.app

# Optional: seed an initial admin at startup when both are set (idempotent).
# INITIAL_ADMIN_USERNAME=admin
# INITIAL_ADMIN_PASSWORD=change-me

# ── Google Sign-In (core/config.py) ───────────────────────────────────────────
# The OAuth 2.0 Client ID used to verify Google ID tokens on POST /auth/google.
# Create one at https://console.cloud.google.com/apis/credentials → "Create
# Credentials" → "OAuth client ID" → Application type "Web application". Add
# your frontend's origin(s) under "Authorized JavaScript origins" there.
# Required for Google Sign-In; the endpoint returns 401 if this is unset.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
