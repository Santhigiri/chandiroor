# Postgres / Neon connection string used by db/database.py.
# Copy this file to .env and fill in your own Neon credentials.
#
# Get this from the Neon console → your project → "Connection Details".
# Keep sslmode=require for Neon. The optional -pooler host uses Neon's
# connection pooler, which is recommended for serverless/many-connection apps.
DATABASE_URL=postgresql://user:password@ep-xxxx-xxxx.region.aws.neon.tech/dbname?sslmode=require

# ── TVM JWT verification (core/config.py) ─────────────────────────────────────
# Chandiroor is a resource server, not an identity provider: it never mints
# tokens or stores credentials. It verifies access tokens minted by TVM (the
# Ashram's auth microservice). At least one of TVM_JWKS_URL / TVM_JWT_PUBLIC_KEY
# must be set, or the app fails fast at startup.
TVM_JWKS_URL=https://tvm.santhigiri.app/.well-known/jwks.json
#
# Fallback signing key (TVM's PEM-encoded RSA *public* key — safe to store,
# it can only verify signatures, never produce one), used whenever the JWKS
# endpoint above is unset or unreachable at verification time. Useful before
# TVM exposes a JWKS endpoint, or to ride out a TVM outage; unlike the JWKS
# path it does not pick up a TVM key rotation automatically. Escape newlines
# as \n if setting this as a single-line env var.
# TVM_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBg...\n-----END PUBLIC KEY-----"
#
# Optional overrides (defaults shown, must match TVM's own jwt.issuer/jwt.audience):
# TVM_JWT_ISSUER=tvm-api
# TVM_JWT_AUDIENCE=tvm-users

# ── CORS (main.py) ────────────────────────────────────────────────────────────
# Credentialed (cookie) requests cannot use a wildcard origin, so list the exact
# frontend origin(s). Defaults to http://localhost:3000 (local dev) and
# https://panchangam.santhigiri.app (production frontend). Override to replace
# the list entirely if you need a different set of origins.
# CORS_ALLOW_ORIGINS=["https://app.example.com"]
#
# CORS_ALLOW_ORIGIN_REGEX currently defaults to `https://.*`, temporarily
# allowing ANY HTTPS origin (matched via regex so credentialed requests still
# work correctly — the specific Origin is reflected back, not a literal "*").
# To tighten this back down, narrow the regex to a specific domain pattern, or
# set it to an empty value to disable it and rely on CORS_ALLOW_ORIGINS alone.
# CORS_ALLOW_ORIGIN_REGEX=https://.*\.santhigiri\.app
