        {
          "name": "Generate Event Occurrences (Admin)",
          "id": "417d8bec-5a9d-4a74-8ecb-1a647c899b4c",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
