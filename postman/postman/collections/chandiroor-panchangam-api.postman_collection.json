                "panchangam",
                "events",
                ":event_id",
                "occurrences"
              ],
              "variable": [
                {
                  "key": "event_id",
                  "value": "POURNAMI_EXAMPLE"
                }
              ]
            },
            "description": "(Re)compute this event's occurrence dates across [start_year, end_year] from the DB's panchangam data and replace what was stored for each of those years.\n\n**Requires `admin` role.**",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}",
                  "type": "string"
                }
              ]
