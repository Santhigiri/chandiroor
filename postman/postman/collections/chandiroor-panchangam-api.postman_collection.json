{
  "info": {
    "_postman_id": "5bb96338-72bb-47d1-b096-301301af1e15",
    "name": "chandiroor-panchangam-api",
    "description": "Panchangam (Indian astrological almanac) API for Santhigiri Ashram.\n\nAuth: Chandiroor is a JWT resource server only \u2014 it never issues tokens. Log in against TVM (the Ashram's auth microservice) and set the `bearerToken` collection/environment variable to the resulting access token. Endpoints marked '(Admin)' require the `admin` role; the rest permit anonymous access but still validate any bearer token supplied.\n\nSet `baseUrl` per environment (Local/Dev/Staging).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Panchangam",
      "item": [
        {
          "name": "Get Day Panchangam",
          "id": "576aef82-2516-40e5-985c-081e270650d5",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/panchangam/day?day=2026-09-19&location=tvm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "panchangam",
                "day"
              ],
              "query": [
                {
                  "key": "day",
                  "value": "2026-09-19"
                },
                {
                  "key": "location",
                  "value": "tvm",
                  "description": "Location code, e.g. 'tvm'"
                }
              ]
            },
            "description": "Compact Panchangam for a single day, served from the DB (falls back to live computation if the date is missing).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
