        {
          "name": "Get Sunrise/Sunset Range",
          "id": "255c7d6f-4973-4d74-9452-1ae9ec2b03d9",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/panchangam/sunrise-sunset/range?latitude=8.645&longitude=76.938&start_date=2026-09-01&end_date=2026-09-30",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "panchangam",
                "sunrise-sunset",
                "range"
              ],
              "query": [
                {
                  "key": "latitude",
                  "value": "8.645"
                },
                {
                  "key": "longitude",
                  "value": "76.938"
                },
                {
                  "key": "start_date",
                  "value": "2026-09-01"
                },
                {
                  "key": "end_date",
                  "value": "2026-09-30"
                }
              ]
            },
            "description": "Bulk sunrise/sunset over an inclusive date range (max 366 days). Always live-computed.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Generate Panchangam (Admin)",
          "id": "a206f9c4-62ce-4ee6-9e4e-d4b3ab3e209b",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/panchangam/generate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "panchangam",
                "generate"
              ]
            },
            "description": "Recomputes the date range from the astronomy code and overwrites the corresponding DB rows.\n\nResponse is streamed as NDJSON: one progress line per day, then a final result line (or an error line). Postman will show the raw streamed body.\n\n**Requires `admin` role.**",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start_date\": \"2026-09-01\",\n  \"end_date\": \"2026-09-30\"\n}",
              "options": {
                "raw": {
                  "headerFamily": "json",
                  "language": "json"
                }
              }
            }
          }
        }
      ],
